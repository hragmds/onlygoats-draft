        </ul>
      </nav>
    </div>
    <div class="og-header-right">
      <a href="https://onlygoatz.com/search" aria-label="Search">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m21 21-3.636-3.636m0 0A9 9 0 1 0 4.636 4.636a9 9 0 0 0 12.728 12.728Z"></path>
        </svg>
      </a>
    </div>
  </header>

  <!-- THREE.JS HERO -->
  <section class="hero-section">
    <div class="hero-canvas-wrapper">
      <HeroCanvas />
      <div class="hero-content">
        <div class="hero-text">
          <div>Unbox the Legends.</div>
          <div>Discover Your GOAT.</div>
        </div>
        <a href="https://onlygoatz.com/collections/all" class="hero-button">Shop Now</a>
      </div>
    </div>
  </section>

  <div class="page-container" id="PageContainer">
    <Fragment set:html={shopifyContent} />
  </div>

</body>
</html>
