<!doctype html>
<html class="no-js" lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#171717">
  <title>OnlyGoatz - Premium Sports Cards</title>
  <link rel="shortcut icon" href="//onlygoatz.com/cdn/shop/files/only-goatz-favicon.png?crop=center&height=32&v=1730303351&width=32" type="image/png">
  <Fragment set:html={`<style data-shopify>${cssVarsContent}</style>`} />
  <link href="//onlygoatz.com/cdn/shop/t/3/assets/theme.css?v=124359794271964460031728497232" rel="stylesheet" type="text/css" media="all">
  <link rel="stylesheet" href="//onlygoatz.com/cdn/shop/t/3/assets/apps.css?v=181017469660800979511727210831" media="print" fetchpriority="low" onload="this.media='all'">
  <script>
    document.documentElement.classList.replace('no-js', 'js');
    window.theme = window.theme || {};
    theme.routes = { root_url: '/', collections_url: '/collections', search_url: '/search' };
    theme.strings = { addToCart: 'Add to cart', soldOut: 'Sold out', unavailable: 'Unavailable' };
    window.Shopify = window.Shopify || {};
    Shopify.routes = { root: '/' };
    Shopify.currency = { active: 'USD', rate: '1.0' };
    Shopify.locale = 'en';
    Shopify.theme = { name: 'Concept', id: 1, role: 'main', style: { id: 3, handle: 'main' } };
    Shopify.shop = 'onlygoatz.myshopify.com';
    Shopify.cdnHost = 'onlygoatz.com/cdn';
  </script>
  <script src="//onlygoatz.com/cdn/shop/t/3/assets/vendor.js?v=36974529011275555061727210831" defer></script>
  <script src="//onlygoatz.com/cdn/shop/t/3/assets/theme.js?v=38496243796543458771727210831" defer></script>
  <style is:global>
    .og-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 40px;
      background-color: #ffffff;
      border-bottom: 1px solid #e5e5e5;
      position: sticky;
      top: 0;
      z-index: 50;
      font-family: Inter, sans-serif;
    }
    .og-header-left {
      display: flex;
      align-items: center;
      gap: 40px;
    }
    .og-header-logo { height: 40px; width: auto; }
    .og-header-nav {
      display: flex;
      gap: 28px;
      align-items: center;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .og-header-nav a {
      text-decoration: none;
      color: #171717;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.01em;
      transition: color 0.2s ease;
    }
    .og-header-nav a:hover { color: #666666; }
    .og-header-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .og-header-right a {
      display: flex;
      align-items: center;
      color: #171717;
      transition: color 0.2s ease;
    }
    .og-header-right a:hover { color: #666666; }
    .og-header-right svg { width: 20px; height: 20px; }
    @media (max-width: 768px) {
      .og-header-nav { display: none; }
      .og-header { padding: 12px 20px; }
    }
    .og-announcement {
      background-color: #d00825;
      color: #ffffff;
      text-align: center;
      padding: 10px 20px;
      font-family: Inter, sans-serif;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.02em;
    }
    .og-announcement a {
      color: #ffffff;
      text-decoration: underline;
      margin-left: 16px;
      font-weight: 700;
    }
    .og-announcement a:hover { opacity: 0.85; }
    #shopify-section-sections--17875971211413__header { display: none !important; }
    #shopify-section-template--17875970752661__slideshow { display: none !important; }
    .hero-section {
      position: relative;
      width: 100%;
      height: 600px;
      display: flex;
      background: #0a0a0a;
      padding: 0;
    }
    .hero-canvas-wrapper {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 0;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .hero-content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 48px;
    }
    .hero-text {
      font-size: 48px;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.2;
      text-align: center;
      font-family: Inter, sans-serif;
    }
    .hero-button {
      padding: 14px 32px;
      background-color: #ffffff;
      color: #000000;
      border: none;
      border-radius: 50px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.3s ease;
      text-decoration: none;
      display: inline-block;
    }
    .hero-button:hover { background-color: #e0e0e0; }
    @media (max-width: 768px) {
      .hero-section { height: 400px; padding: 0; }
      .hero-text { font-size: 32px; }
    }
  </style>
</head>
